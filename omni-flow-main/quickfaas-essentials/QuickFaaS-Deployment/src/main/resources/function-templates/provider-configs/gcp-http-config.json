{
  "description": "QuickFaaS cloud-agnostic function",
  "buildConfig": {
    "runtime": "<runtime>",
    "entryPoint": "<entry_point>",
    "source": {
      "storageSource": {
        "bucket": "<bucket>",
        "object": "quickfaas/<name>/<zip_file>"
      }
    }
  },
  "serviceConfig": {
    "availableMemory": "256Mi",
    "timeoutSeconds": 60,
    "maxInstanceCount": 100,
    "minInstanceCount": 0,
    "ingressSettings": "ALLOW_ALL"
  }
}
