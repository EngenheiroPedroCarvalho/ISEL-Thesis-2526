source_contents: "main:\n    params: [ transaction ]\n    steps:\n        - fraud-check:\n            call: http.post\n            args:\n                url: https://fraud-check-jllpr4krfq-ew.a.run.app\n                query:\n                    amount: ${transaction.amount}\n                    country: ${transaction.country}\n            result: fraudResult\n        - risk-score:\n            call: http.post\n            args:\n                url: https://risk-score-jllpr4krfq-ew.a.run.app\n                query:\n                    amount: ${transaction.amount}\n            result: riskResult\n        - decision:\n            switch:\n                - condition:\n                    ${fraudResult.body.flagged == true}\n                  next: decline-transaction\n                - condition:\n                    ${riskResult.body.score > 75}\n                  next: decline-transaction\n            next: approve-transaction\n        - approve-transaction:\n            next: report-decision\n            assign:\n                - decision: \'approved\'\n        - decline-transaction:\n            assign:\n                - decision: \'declined\'\n        - report-decision:\n            call: http.post\n            args:\n                url: https://core-banking-stub-jllpr4krfq-ew.a.run.app/\n                query:\n                    decision: ${decision}\n                body: ${transaction}\n            result: coreBankingResult\n        - return_output:\n            return: ${decision}"

