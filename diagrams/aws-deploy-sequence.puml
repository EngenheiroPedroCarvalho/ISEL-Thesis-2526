@startuml aws-deploy-sequence
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 11
title AWS deployment sequence

participant "AmazonCloudDeployer" as ACD
participant "AwsInternalFunctionResolver" as R
participant "FunctionRegistryStore" as REG
participant "AwsLambdaDeployer" as ALD
participant "AwsLambdaIamHelper" as IAM
participant "QuickFaasProcessInvoker" as PI
participant "QuickFaaS JAR\n(AwsProvider)" as QF
participant "AWS APIs\n(EC2, IAM, S3, Lambda)" as AWS
participant "AWS Step Functions" as SFN

opt workflow has internal calls
  opt registry file missing
    ACD -> AWS : DescribeRegions + ListFunctions\n(every enabled region)
    ACD -> REG : writeNew(functions)
  end
  ACD -> R : resolve(workflow)
  R -> REG : readAll()
  REG --> R : snapshot
  loop for each CallContext with internalFunction
    R -> R : tryResolveEntryIn(name, snapshot)
    alt Level 1 - registry hit
      R -> AWS : GetFunction(region from ARN, serviceName)
      note right of R
        drift, rediscovery and stale-entry removal
        as in resolution-cascade-level1-aws.puml
      end note
      AWS --> R : FunctionArn
    else Level 2 - registry miss, function found by discovery
      R -> AWS : DescribeRegions (enabled regions)
      loop for each region, preferred first, until >1 match
        R -> AWS : GetFunction(region, name)
      end
      AWS --> R : exactly one FunctionArn
      R -> REG : put(name, metadata)
    else Level 3 - absent in every region, descriptor provided
      R -> ALD : deployOrUpdate(name, descriptorPath)
      ALD -> IAM : resolveOrCreateLambdaExecutionRole(iamRoleArn)
      IAM -> AWS : GetRole / CreateRole + AttachRolePolicy
      AWS --> IAM : execution role ARN
      ALD -> ALD : patchIamRoleArn(descriptor)\n-> temp descriptor
      ALD -> ALD : load + validate(descriptor, "aws")
      ALD -> AWS : GetBucketLocation -> effective region
      ALD -> PI : invoke(descriptor)\n[<=3 attempts, 20 s backoff\non IAM propagation]
      PI -> QF : java -jar QuickFaaS.jar
      QF -> QF : build hook + template,\nzip sources
      QF -> AWS : PutObject (S3 bucket)
      QF -> AWS : CreateFunction /\nUpdateFunctionCode
      QF -> AWS : GetFunctionUrlConfig /\nCreateFunctionUrlConfig
      QF --> PI : deployment finished
      ALD -> AWS : GetFunction - poll until\nState = Active (<=180 s, 5 s interval)
      ALD -> AWS : GetFunction -> FunctionArn
      ALD -> IAM : grantStepFunctionsInvoke(name, region, roleArn)
      IAM -> AWS : AddPermission\n(principal = states.amazonaws.com)
      ALD --> R : FunctionInvocationMetadata\n(serviceName, url = ARN)
      R -> REG : put(name, metadata)
    else absent, no descriptor / ambiguous / regions inaccessible
      R --> ACD : IllegalStateException (fail fast)
    end
    R -> R : call.copy(host = "lambda://" + ARN,\npath = e)
  end
  R --> ACD : resolved workflow
end
ACD -> ACD : render -> ASL with Resource\n"arn:aws:states:::lambda:invoke"
ACD -> SFN : CreateStateMachine(name, roleArn, definition)
SFN --> ACD : StateMachineArn
@enduml
