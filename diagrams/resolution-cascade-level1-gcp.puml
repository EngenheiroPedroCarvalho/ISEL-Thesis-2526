@startuml resolution-cascade-level1-gcp
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 11
title Resolution ladder -- Level 1: Registry lookup and live validation (GCP)

participant "Resolver\n(WorkflowInternalFunctionResolver)" as R
participant "FunctionRegistryStore" as REG
participant "CloudRunV2ServiceInspector" as GI

note over R, REG
  resolve() reads the registry once (readAll) into a snapshot;
  lookups run against it, and every put/remove updates both
end note
R -> R : tryResolveEntryIn(functionRef, snapshot)\n[exact match, then "<region>/<functionRef>" suffix]
alt registry miss
  note over R
    continues at Level 2 - Provider discovery
    (see the Level 2 diagram)
  end note
else suffix matches several keys
  R --> R : throw IllegalStateException\n(ambiguous in the registry - use "<region>/<functionRef>")
else registry hit
  R -> R : entry = (key, metadata)

  R -> GI : lookupByServiceName(metadata.serviceName)
  alt Found - same URL
    GI --> R : Found(serviceName, url == metadata.url)
    R --> R : return metadata.url
  else Found - drifted URL
    GI --> R : Found(serviceName, url != metadata.url)
    R -> REG : put(key, metadata.copy(url = newUrl))
    R --> R : return newUrl
  else NotFound
    GI --> R : NotFound
    R -> R : discoverServiceForRef(functionRef)\n[as in Level 2: every region, or only the\nregion named by "<region>/<functionRef>"]
    alt rediscovered elsewhere (exactly one match)
      opt key != functionRef
        R -> REG : remove(key)
      end
      R -> REG : put(functionRef, newMetadata)
      R --> R : return newUrl
    else ambiguous, or some regions not accessible
      R --> R : throw IllegalStateException
    else still not found
      R -> REG : remove(key)
      R --> R : throw IllegalStateException\n(stale entry removed - deleted service)
    end
  else Forbidden
    GI --> R : Forbidden(message)
    R --> R : throw IllegalStateException\n(cannot validate via Cloud Run APIs)
  end
end
@enduml
