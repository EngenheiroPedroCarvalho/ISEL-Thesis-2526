@startuml resolution-cascade-level1-aws
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 11
title Resolution cascade -- Level 1: Registry lookup and live validation (AWS)

participant "Resolver\n(AwsInternalFunctionResolver)" as R
participant "FunctionRegistryStore" as REG
participant "LambdaFunctionInspector" as AI

R -> REG : tryResolveEntry(functionRef)\n[exact match, then "<region>/<functionRef>" suffix]
alt registry miss
  REG --> R : null
  note over R
    continues at Level 2 - Provider discovery
    (see resolution-cascade-level2-aws.puml)
  end note
else registry hit
  REG --> R : (key, metadata)

  R -> AI : lookupByFunctionName(metadata.serviceName)
  alt Found - same ARN
    AI --> R : Found(functionName, arn == metadata.url)
    R --> R : return metadata.url
  else Found - drifted ARN
    AI --> R : Found(functionName, arn != metadata.url)
    R -> REG : put(key, metadata.copy(url = newArn))
    R --> R : return newArn
  else NotFound
    AI --> R : NotFound
    note right of R
      no rediscovery attempt on AWS
      (Lambda names are unique per region,
      so a miss is treated as final)
    end note
    R -> REG : remove(key)
    R --> R : throw IllegalStateException\n(stale entry removed - deleted function)
  else Forbidden
    AI --> R : Forbidden(message)
    R --> R : throw IllegalStateException\n(cannot validate via the Lambda API)
  end
end
@enduml
