@startuml resolution-cascade-level2
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 11
title Resolution cascade -- Level 2: Provider discovery

participant "Resolver\n(WorkflowInternalFunctionResolver /\nAwsInternalFunctionResolver)" as R
participant "FunctionRegistryStore" as REG
participant "CloudRunV2ServiceInspector\n(GCP)" as GI
participant "CloudRunLocationsV1RestClient\n(GCP, region list)" as GL
participant "LambdaFunctionInspector\n(AWS)" as AI

note over R
  reached only on a Level 1 registry miss
  (see resolution-cascade-level1.puml)
end note

alt GCP
  alt functionRef is "<region>/<service>"
    R -> GI : lookup(project, region, serviceId)
  else bare functionRef
    R -> GL : listProjectLocations(project)
    GL --> R : regions (lazy, preferred first)
    loop for each region, until >1 match found
      R -> GI : lookup(project, region, functionRef)
      GI --> R : Found / NotFound / Forbidden
    end
  end

  alt exactly one match
    R -> REG : put(functionRef, metadata)
    R --> R : return url
  else more than one match
    R --> R : throw IllegalStateException\n(ambiguous - disambiguate with "<region>/<functionRef>")
  else no match, some regions Forbidden
    R --> R : throw IllegalStateException\n(cannot confirm - some regions not accessible)
  else no match, all regions checked cleanly
    note right of R
      empty result, no exception --
      falls through to Level 3 below
    end note
  end

else AWS
  R -> AI : lookupByFunctionName(functionName)
  alt Found
    AI --> R : Found(functionName, arn)
    R -> REG : put(functionName, metadata(url = arn))
    R --> R : return arn
  else NotFound or Forbidden
    AI --> R : NotFound / Forbidden
    note right of R
      both collapse to "miss" here and are
      merely logged as a warning -- unlike Level 1,
      a permissions failure is not distinguished
      from a genuine absence on this path
    end note
  end
end

alt no match found (either provider) and deploymentDescriptorPath supplied
  note over R
    continues at Level 3 - QuickFaaS deployment
    (see resolution-cascade-level3.puml)
  end note
else no match found and no descriptor supplied
  R --> R : throw IllegalStateException\n(fail fast - deploy it first or provide deploymentDescriptorPath)
end
@enduml
