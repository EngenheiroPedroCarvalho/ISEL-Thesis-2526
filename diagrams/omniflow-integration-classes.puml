@startuml omniflow-integration-classes
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 12
title Integration layer added to OmniFlow
left to right direction
hide empty members

interface InternalFunctionDeployer {
  +deployOrUpdate(functionName, deploymentDescriptorPath) : FunctionInvocationMetadata
}

class NoopInternalFunctionDeployer <<object>> {
  +deployOrUpdate(...) : throws UnsupportedOperationException
}

class QuickFaasDeployer {
  -quickFaasJarPath : Path
  -projectId : String
  -region : String
  -invokerServiceAccount : String[0..1]
  -readinessTimeoutSeconds : Long
  -readinessPollIntervalSeconds : Long
  +deployOrUpdate(...) : FunctionInvocationMetadata
}

class AwsLambdaDeployer {
  -quickFaasJarPath : Path
  -region : String
  -roleArn : String
  -readinessTimeoutSeconds : Long
  -readinessPollIntervalSeconds : Long
  +deployOrUpdate(...) : FunctionInvocationMetadata
  -patchIamRoleArn(path, roleArn) : Path
  -invokeWithRoleRetry(invoker, path)
  -waitForLambdaActive(name, region)
  -resolveBucketRegion(bucket) : String
}

class WorkflowInternalFunctionResolver {
  -projectId : String
  -preferredRegion : String[0..1]
  +resolve(workflow) : Workflow
  -resolveOrDiscoverInternal(ref, fn, snapshot) : String
  -discoverServiceForRef(ref) : List
}

class AwsInternalFunctionResolver {
  -preferredRegion : String[0..1]
  +resolve(workflow) : Workflow
  -resolveOrDeploy(ref, fn, snapshot) : String
  -discoverFunctionForRef(ref) : List
}

class CloudRunV2ServiceInspector {
  +lookupByServiceName(serviceName) : LookupResult
  +lookup(projectId, region, serviceId) : LookupResult
}

class CloudRunLocationsV1RestClient {
  +listProjectLocations(projectId) : List<String>
}

interface LambdaFunctionInspector {
  +lookup(region, functionName) : LookupResult
}

interface AwsRegionsLister {
  +listRegions(bootstrapRegion) : List<String>
}

class FunctionRegistryStore {
  -file : Path
  +readAll() : Map
  +tryResolveEntryIn(ref, snapshot) : Pair[0..1]
  +put(key, metadata)
  +remove(key)
}

class FunctionInvocationMetadata {
  +serviceName : String
  +url : String
}

class FunctionRegistryBootstrapper {
  +bootstrapIfMissing(scope)
}

interface CloudFunctionsCatalog {
  +listHttpFunctions(scope) : Map
}

class GoogleCloudDeployer
class AmazonCloudDeployer

InternalFunctionDeployer <|.. NoopInternalFunctionDeployer
InternalFunctionDeployer <|.. QuickFaasDeployer
InternalFunctionDeployer <|.. AwsLambdaDeployer
GoogleCloudDeployer --> WorkflowInternalFunctionResolver
AmazonCloudDeployer --> AwsInternalFunctionResolver
GoogleCloudDeployer --> FunctionRegistryBootstrapper
AmazonCloudDeployer --> FunctionRegistryBootstrapper
WorkflowInternalFunctionResolver --> FunctionRegistryStore
AwsInternalFunctionResolver --> FunctionRegistryStore
WorkflowInternalFunctionResolver --> InternalFunctionDeployer
AwsInternalFunctionResolver --> InternalFunctionDeployer
WorkflowInternalFunctionResolver --> CloudRunV2ServiceInspector
WorkflowInternalFunctionResolver --> CloudRunLocationsV1RestClient
AwsInternalFunctionResolver --> LambdaFunctionInspector
AwsInternalFunctionResolver --> AwsRegionsLister
FunctionRegistryStore ..> FunctionInvocationMetadata
FunctionRegistryBootstrapper --> FunctionRegistryStore
FunctionRegistryBootstrapper --> CloudFunctionsCatalog

note bottom of FunctionInvocationMetadata
  url holds an HTTPS endpoint on GCP
  and a Lambda ARN on AWS
end note

note bottom of FunctionRegistryStore
  each resolve() reads the registry once (readAll)
  into a snapshot; lookups use tryResolveEntryIn
  and every put/remove also updates the snapshot
end note

note bottom of CloudFunctionsCatalog
  scope = GCP project id or AWS region;
  implemented by CloudRunV2RestCatalog
  and LambdaFunctionsCatalog
end note
@enduml
